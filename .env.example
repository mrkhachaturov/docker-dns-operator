# Template for the full all-providers example.
# Copy to .env (gitignored) and fill in:
#   cp .env.example .env
#
# Real defaults (booleans, TTLs) are pre-set. Identity values (addresses,
# zones, hosts, realms, principals) are intentionally empty — fill them in
# or the corresponding sidecar will refuse to start.

# --- Cloudflare (consumed by the ddo-cloudflare sidecar) ----------------------
# Token with Zone.DNS:Edit on the zone you'll write to. Becomes
# CLOUDFLARE_API_TOKEN on the sidecar.
CF_API_TOKEN=
# Optional zone allow-list (comma-separated). Empty = every zone visible to the
# token. Becomes CLOUDFLARE_ZONES on the sidecar.
CF_ZONES=
# Cloudflare convention: 1 = "automatic". Anything else must be >=60.
CF_DEFAULT_TTL=1
# NOTE: Proxied (orange-cloud) state is per-record via the label
# providerOptions.cf.proxy — not set here. Sidecar default is `false`.

# --- MikroTik RouterOS (consumed by the ddo-mikrotik sidecar) -----------------
# Native RouterOS API endpoint, host:port.
#   8728 — cleartext binary API
#   8729 — api-ssl (set MIKROTIK_USE_TLS=true)
# Example: 10.0.0.1:8728
MIKROTIK_ADDRESS=
# RouterOS user with read+write+api policies. Create a dedicated user
# (see README), do NOT reuse admin. Example: external-dns
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
# Dial the api-ssl service (typically port 8729). Leave false for cleartext on 8728.
MIKROTIK_USE_TLS=false
# Only honoured when MIKROTIK_USE_TLS=true. Use for self-signed router certs.
MIKROTIK_SKIP_TLS_VERIFY=false
# Optional comma-separated zones the sidecar advertises on GET / (DomainFilter)
# and enforces on inbound writes. Empty = accept any FQDN.
MIKROTIK_ZONES=

# --- RFC2136 / Active Directory (consumed by the ddo-rfc2136 sidecar) ---------
# Comma-separated FQDNs of your DCs in failover order. IPs and short names are
# rejected — the host you reach is the SPN for GSS-TSIG.
# Example: dc01.ad.example.org,dc02.ad.example.org
RFC2136_HOSTS=
# Comma-separated zones the operator may write to.
# Example: ad.example.org
RFC2136_ZONES=
# Realm — uppercase. Example: AD.EXAMPLE.ORG
RFC2136_KERBEROS_REALM=
# Principal — must end with @<realm>. Example: svc-dns@AD.EXAMPLE.ORG
RFC2136_KERBEROS_PRINCIPAL=

# Pick exactly ONE of the following two and leave the other unset.
# Password mode is simpler and matches k8s external-dns. Keytab mode is
# defense-in-depth (keytab carries derived keys, not the plaintext password).
RFC2136_AD_PASSWORD=
RFC2136_KEYTAB_BASE64=

# Set true to log intended DNS UPDATEs without applying them. Useful for the
# first run against a new DC.
RFC2136_DRY_RUN=false

# --- Test record --------------------------------------------------------------
# A name within ALL three providers' authoritative scope (Cloudflare zone +
# RFC2136_ZONES). MikroTik takes anything. Use a prefix that won't collide with
# real records — the operator only touches records tagged PROJECT_LABEL:INSTANCE_ID,
# but a ddo-test-* prefix keeps the blast radius obvious.
# Example: ddo-test-full.ad.example.org
TEST_RECORD_NAME=
# An RFC 5737 TEST-NET-1 address (192.0.2.0/24) is a safe default for smoke tests.
TEST_RECORD_VALUE=
