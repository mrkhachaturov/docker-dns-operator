# Template for the full all-providers example.
# Copy to .env (which is gitignored) and fill in your real values:
#   cp .env.example .env

# --- Cloudflare ---------------------------------------------------------------
# Token with Zone.DNS:Edit on the zone you'll be writing to.
CF_API_TOKEN=

# --- MikroTik RouterOS --------------------------------------------------------
MIKROTIK_BASEURL=https://192.168.1.1
MIKROTIK_USERNAME=docker-dns-operator
MIKROTIK_PASSWORD=
# Default is true (self-signed certs are normal on RouterOS). Set to false
# only when MIKROTIK_BASEURL points at a publicly-trusted certificate.
MIKROTIK_SKIP_TLS_VERIFY=true

# --- RFC2136 / Active Directory -----------------------------------------------
# Comma-separated FQDNs of your DCs (IPs and short names are rejected).
RFC2136_HOSTS=dc01.corp.example.com,dc02.corp.example.com
# Comma-separated zones the operator may write to.
RFC2136_ZONES=corp.example.com
# Realm must be uppercase. Principal must end with @REALM.
RFC2136_KERBEROS_REALM=CORP.EXAMPLE.COM
RFC2136_KERBEROS_PRINCIPAL=svc-dns@CORP.EXAMPLE.COM

# Pick exactly ONE of the following two and leave the other unset.
# Password mode is simpler and matches k8s external-dns. Keytab mode is for
# defense-in-depth (keytab contains derived keys, not the plaintext password).
RFC2136_AD_PASSWORD=
RFC2136_KEYTAB_BASE64=

# Set to true to log intended DNS UPDATEs instead of applying them. Useful for
# the first run against a new DC.
RFC2136_DRY_RUN=false

# --- Test record --------------------------------------------------------------
# A safe name within ALL three providers' authoritative scope (Cloudflare zone
# + RFC2136_ZONES). MikroTik takes anything. The operator only touches records
# tagged with PROJECT_LABEL:INSTANCE_ID, so a prefix like ddo-test-* keeps
# real records out of the blast radius.
TEST_RECORD_NAME=ddo-test-full.corp.example.com
TEST_RECORD_VALUE=192.0.2.10
