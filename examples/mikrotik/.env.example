# Template — copy to .env (gitignored) and fill in.

# REST API URL of your router. Standard ports: 80 (www) / 443 (www-ssl).
MIKROTIK_BASEURL=https://192.168.1.1

# RouterOS user with /ip/dns/* policy. Best practice: create a dedicated
# user (e.g. "external-dns") in a custom group with only read+write+rest-api
# policies — see README.md for the step-by-step setup. Do NOT reuse admin.
MIKROTIK_USERNAME=external-dns
MIKROTIK_PASSWORD=

# RouterOS ships a self-signed cert by default. Leave true unless you've
# imported a publicly-trusted cert into MIKROTIK_BASEURL.
MIKROTIK_SKIP_TLS_VERIFY=true

# Any name — MikroTik is not zone-aware. Use a prefix that won't collide
# with real records.
TEST_RECORD_NAME=ddo-test-mt.lan
TEST_RECORD_VALUE=10.99.0.10
