# Template — copy to .env (gitignored) and fill in.

# Native RouterOS API endpoint, host:port.
#   8728 — cleartext binary API
#   8729 — api-ssl (set MIKROTIK_USE_TLS=true to use this)
MIKROTIK_ADDRESS=192.168.1.1:8728

# RouterOS user with read+write+api policies. Best practice: create a
# dedicated user (e.g. "external-dns") — see README.md for the step-by-step
# setup. Do NOT reuse admin.
MIKROTIK_USERNAME=external-dns
MIKROTIK_PASSWORD=

# Dial the api-ssl service (typically port 8729 — update MIKROTIK_ADDRESS
# accordingly). Leave false for the cleartext binary API on 8728.
MIKROTIK_USE_TLS=false
# Only honoured when MIKROTIK_USE_TLS=true. Use for self-signed router
# certs in lab environments.
MIKROTIK_SKIP_TLS_VERIFY=false

# Optional. Comma-separated zone list returned on GET / (DomainFilter) and
# used to constrain inbound writes. Empty = accept any FQDN.
MIKROTIK_ZONES=

# Any name within MIKROTIK_ZONES (or any name if empty). Use a prefix that
# won't collide with real records.
TEST_RECORD_NAME=ddo-test-mt.lan
TEST_RECORD_VALUE=10.99.0.10
