# Template — copy to .env (gitignored) and fill in.

# --- DC + zone targeting ------------------------------------------------------
# Comma-separated FQDNs of your DCs in failover order. IPs and short names are
# rejected — the host you reach is the SPN for GSS-TSIG, so it must be a real
# DNS name that matches the cert/principal AD will hand out.
RFC2136_HOSTS=dc01.corp.example.com,dc02.corp.example.com

# Comma-separated zones the operator may write to.
RFC2136_ZONES=corp.example.com

# --- Kerberos -----------------------------------------------------------------
# Realm must be uppercase. Principal must end with @<realm>.
RFC2136_KERBEROS_REALM=CORP.EXAMPLE.COM
RFC2136_KERBEROS_PRINCIPAL=svc-dns@CORP.EXAMPLE.COM

# --- Pick exactly ONE of the next two -----------------------------------------
# Password mode (recommended): the sidecar runs `kinit <principal>` with
# the password piped via stdin. Simplest setup; matches k8s external-dns.
RFC2136_AD_PASSWORD=

# Keytab mode (defense-in-depth): base64 of a keytab generated on a DC via
# scripts/New-ADKeytab.ps1 -EmitBase64 (in the sidecar repo). Decoded into a
# 0600 temp file at sidecar startup.
RFC2136_KEYTAB_BASE64=

# --- Optional -----------------------------------------------------------------
# Set true to log intended UPDATEs without applying — useful for first run.
RFC2136_DRY_RUN=false

# --- Test record --------------------------------------------------------------
# A name inside RFC2136_ZONES. Use a prefix that won't collide with real
# records.
TEST_RECORD_NAME=ddo-test-ad.corp.example.com
TEST_RECORD_VALUE=192.0.2.10
