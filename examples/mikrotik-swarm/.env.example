# Template — copy to .env (gitignored) and fill in.

# REST API URL of your router.
MIKROTIK_BASEURL=https://192.168.1.1

# Same SA setup as examples/mikrotik/ — see that README for the
# external-dns user/group recipe.
MIKROTIK_USERNAME=external-dns
MIKROTIK_PASSWORD=

MIKROTIK_SKIP_TLS_VERIFY=true

# Any name — use a prefix that won't collide with real records.
TEST_RECORD_NAME=ddo-test-mt-swarm.lan
TEST_RECORD_VALUE=10.99.0.20
