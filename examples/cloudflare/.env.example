# Template — copy to .env (gitignored) and fill in.

# Cloudflare API token with Zone.DNS:Edit on the zone you'll write to.
# Create one at https://dash.cloudflare.com/profile/api-tokens.
CF_API_TOKEN=

# Optional comma-separated zone allow-list. Empty = every zone visible to the
# token.
CF_ZONES=

# Test record. A name within a zone your token has access to. Use a prefix
# (e.g. ddo-test-*) so the ownership tag doesn't collide with real records.
# Example: ddo-test-cf.example.com
TEST_RECORD_NAME=
# RFC 5737 TEST-NET-1 (192.0.2.0/24) is a safe placeholder.
TEST_RECORD_VALUE=
