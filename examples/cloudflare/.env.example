# Template — copy to .env (gitignored) and fill in.

# Cloudflare API token with Zone.DNS:Edit on the zone you'll write to.
# Create one at https://dash.cloudflare.com/profile/api-tokens.
CF_API_TOKEN=

# Optional comma-separated zone allow-list. Empty = every zone visible to the
# token.
CF_ZONES=

# Default Cloudflare proxy state for A/CNAME entries that don't set
# providerOptions.cf.proxy explicitly.
CF_PROXIED_DEFAULT=false

# A name within a zone your token has access to. Use a unique prefix
# (ddo-test-*) so the operator's ownership tag doesn't collide with anything
# real.
TEST_RECORD_NAME=ddo-test-cf.somedomain.net
TEST_RECORD_VALUE=192.0.2.10
